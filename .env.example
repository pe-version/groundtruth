# Copy this to .env and fill in your values
# Never commit .env to git

# ── LLM & Embeddings ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here           # Still needed for embeddings (text-embedding-3-small)

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-at-least-32-characters-here

# ── Infrastructure ────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=groundtruth-consumer
MONGO_URI=mongodb://localhost:27017/groundtruth
POSTGRES_DSN=postgres://groundtruth:groundtruth@localhost:5432/groundtruth?sslmode=disable
POSTGRES_PASSWORD=groundtruth

# ── Application ───────────────────────────────────────────────────
PORT=8080
UPLOAD_DIR=/tmp/uploads
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_API_URL=http://localhost:8080

# ── GitHub OAuth (optional — enables "Sign in with GitHub") ───────
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to: http://localhost:3000/api/auth/callback/github
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
#
# Server-to-server secret for the /api/auth/oauth-token endpoint.
# Must match on both the API and the frontend (NextAuth server).
# Never exposed to the browser. Generate with: openssl rand -base64 32
# OAUTH_SERVER_SECRET=change-me-generate-with-openssl-rand-base64-32
