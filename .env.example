# Copy this to .env and fill in your values
# Never commit .env to git

# ── LLM & Embeddings ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here           # Still needed for embeddings (text-embedding-3-small)

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-at-least-32-characters-here

# ── Infrastructure ────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=direze-consumer
MONGO_URI=mongodb://localhost:27017/direze
POSTGRES_DSN=postgres://direze:direze@localhost:5432/direze?sslmode=disable
POSTGRES_PASSWORD=direze

# ── Application ───────────────────────────────────────────────────
PORT=8080
UPLOAD_DIR=/tmp/uploads
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_API_URL=http://localhost:8080
