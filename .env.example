# Copy this to .env and fill in your values
# Never commit .env to git

# ── LLM ───────────────────────────────────────────────────────────
# Embeddings now run locally (transformers.js + bge-small-en-v1.5),
# so no OpenAI key is required.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Auth ──────────────────────────────────────────────────────────
# Used by the API to sign 15-min access JWTs. Refresh tokens are
# server-side state in Postgres and don't need a separate secret.
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-at-least-32-characters-here

# ── Infrastructure ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/groundtruth
POSTGRES_DSN=postgres://groundtruth:groundtruth@localhost:5432/groundtruth?sslmode=disable
POSTGRES_PASSWORD=groundtruth

# ── Application ───────────────────────────────────────────────────
PORT=8080
UPLOAD_DIR=/tmp/uploads
CORS_ORIGINS=http://localhost:3000

# How often the consumer polls the job queue when idle (ms).
POLL_INTERVAL_MS=1000

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api
